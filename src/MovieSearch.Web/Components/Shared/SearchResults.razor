<div class="results-grid">
    @foreach (var movie in Movies)
    {
        <div class="movie-card" @onclick="() => OnMovieSelected.InvokeAsync(movie.ImdbId)">
            @if (!string.IsNullOrEmpty(movie.Poster) && movie.Poster != "N/A")
            {
                <img src="@movie.Poster"
                     alt="@movie.Title"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="no-poster" style="display:none;">No poster</div>
            }
            else
            {
                <div class="no-poster">No poster</div>
            }
            <div class="movie-card-info">
                <strong>@movie.Title</strong>
                <span>@movie.Year</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<Movie> Movies { get; set; } = Enumerable.Empty<Movie>();
    [Parameter] public EventCallback<string> OnMovieSelected { get; set; }
}